<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Doodle Mini</title>
  <!-- Telegram Web App SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #181818;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      touch-action: none;
      font-family: sans-serif;
    }
    canvas {
      display: block;
      background: #faf8ef;
    }
  </style>
</head>
<body>

<canvas id="game"></canvas>

<script>
  // Инициализация внутри Telegram
  if (window.Telegram && window.Telegram.WebApp) {
    Telegram.WebApp.ready();
    Telegram.WebApp.expand();
  }

  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');

  // Адаптация размера под экран смартфона
  const width = Math.min(window.innerWidth, 420);
  const height = window.innerHeight;
  canvas.width = width;
  canvas.height = height;

  // Параметры персонажа
  const player = {
    x: width / 2 - 15,
    y: height - 150,
    w: 30,
    h: 30,
    vx: 0,
    vy: 0,
    jump: -10.5,
    gravity: 0.32
  };

  let score = 0;
  let gameOver = false;

  // Платформы
  const platWidth = 65;
  const platHeight = 12;
  const platforms = [];
  const platCount = 7;

  // Начальная генерация платформ
  platforms.push({ x: width / 2 - platWidth / 2, y: height - 60 });
  for (let i = 1; i < platCount; i++) {
    platforms.push({
      x: Math.random() * (width - platWidth),
      y: (height / platCount) * i
    });
  }

  // Управление через тапы по экрану
  let moveDir = 0;

  window.addEventListener('touchstart', (e) => {
    if (gameOver) {
      restart();
      return;
    }
    const touchX = e.touches[0].clientX;
    const canvasLeft = canvas.getBoundingClientRect().left;
    const relX = touchX - canvasLeft;

    moveDir = relX < width / 2 ? -1 : 1;
  });

  window.addEventListener('touchend', () => {
    moveDir = 0;
  });

  function restart() {
    player.x = width / 2 - 15;
    player.y = height - 150;
    player.vx = 0;
    player.vy = 0;
    score = 0;
    gameOver = false;
    platforms.length = 0;

    platforms.push({ x: width / 2 - platWidth / 2, y: height - 60 });
    for (let i = 1; i < platCount; i++) {
      platforms.push({
        x: Math.random() * (width - platWidth),
        y: (height / platCount) * i
      });
    }
  }

  function update() {
    if (gameOver) return;

    // Горизонтальное движение с трением
    player.vx = moveDir * 5;
    player.x += player.vx;

    // Телепортация через края экрана
    if (player.x > width) player.x = -player.w;
    if (player.x + player.w < 0) player.x = width;

    // Гравитация
    player.vy += player.gravity;
    player.y += player.vy;

    // Проверка приземления на платформы (только при падении вниз)
    if (player.vy > 0) {
      platforms.forEach(p => {
        if (
          player.x + player.w > p.x &&
          player.x < p.x + platWidth &&
          player.y + player.h >= p.y &&
          player.y + player.h <= p.y + platHeight + player.vy
        ) {
          player.vy = player.jump;
        }
      });
    }

    // Сдвиг камеры вверх при достижении верхней половины
    if (player.y < height / 2) {
      const diff = height / 2 - player.y;
      player.y = height / 2;
      score += Math.floor(diff);

      platforms.forEach(p => {
        p.y += diff;
        // Если платформа ушла за низ — переносим наверх
        if (p.y > height) {
          p.y = 0;
          p.x = Math.random() * (width - platWidth);
        }
      });
    }

    // Проигрыш при падении в яму
    if (player.y > height) {
      gameOver = true;
    }
  }

  function draw() {
    ctx.clearRect(0, 0, width, height);

    // Отрисовка платформ
    ctx.fillStyle = '#4CAF50';
    platforms.forEach(p => {
      ctx.fillRect(p.x, p.y, platWidth, platHeight);
    });

    // Отрисовка игрока
    ctx.fillStyle = '#FF5722';
    ctx.fillRect(player.x, player.y, player.w, player.h);

    // Очки
    ctx.fillStyle = '#333';
    ctx.font = 'bold 20px sans-serif';
    ctx.fillText('Счет: ' + score, 16, 36);

    // Экран конца игры
    if (gameOver) {
      ctx.fillStyle = 'rgba(0, 0, 0, 0.65)';
      ctx.fillRect(0, 0, width, height);

      ctx.fillStyle = '#fff';
      ctx.textAlign = 'center';
      ctx.font = 'bold 26px sans-serif';
      ctx.fillText('ИГРА ОКОНЧЕНА', width / 2, height / 2 - 20);
      ctx.font = '16px sans-serif';
      ctx.fillText('Нажми в любое место, чтобы начать заново', width / 2, height / 2 + 20);
      ctx.textAlign = 'left';
    }
  }

  function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
  }

  loop();
</script>
</body>
</html>
